<Window x:Class="pr7border.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор строительных материалов" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <TabControl>

            
              <!-- Вкладка 1: Обои -->
            <TabItem Header="🎨 Обои">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                                   Text="Расчёт количества обоев для комнаты" 
                                   FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,25"
                                   Foreground="#FF1976D2"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" 
                                Background="#FFE3F2FD" BorderBrush="#FFBBDEFB" 
                                BorderThickness="1" CornerRadius="4" Margin="0,5">
                            <TextBlock Text="📐 Размеры комнаты" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ширина комнаты (м):" Margin="5,10"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtRoomWidth" Text="4,0" Margin="5,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="например: 4,0" Foreground="Gray" Margin="5,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Длина комнаты (м):" Margin="5,10"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="txtRoomLength" Text="5,0" Margin="5,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="например: 5,0" Foreground="Gray" Margin="5,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Высота комнаты (м):" Margin="5,10"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Name="txtRoomHeight" Text="2,7" Margin="5,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="например: 2,7" Foreground="Gray" Margin="5,10"/>

                        <Border Grid.Row="5" Grid.ColumnSpan="3" 
                                Background="#FFF3E5F5" BorderBrush="#FFE1BEE7" 
                                BorderThickness="1" CornerRadius="4" Margin="0,15,0,5">
                            <TextBlock Text="🪟 Окно" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Ширина окна (м):" Margin="5,10"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Name="txtWindowWidth" Text="1,5" Margin="5,5"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="например: 1,5" Foreground="Gray" Margin="5,10"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Высота окна (м):" Margin="5,10"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Name="txtWindowHeight" Text="1,2" Margin="5,5"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="например: 1,2" Foreground="Gray" Margin="5,10"/>

                        <Border Grid.Row="8" Grid.ColumnSpan="3" 
                                Background="#FFE8F5E8" BorderBrush="#FFC8E6C9" 
                                BorderThickness="1" CornerRadius="4" Margin="0,15,0,5">
                            <TextBlock Text="🚪 Дверь" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Ширина двери (м):" Margin="5,10"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Name="txtDoorWidth" Text="0,8" Margin="5,5"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="например: 0,8" Foreground="Gray" Margin="5,10"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Высота двери (м):" Margin="5,10"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Name="txtDoorHeight" Text="2,0" Margin="5,5"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="например: 2,0" Foreground="Gray" Margin="5,10"/>

                        <Border Grid.Row="11" Grid.ColumnSpan="3" 
                                Background="#FFFFF8E1" BorderBrush="#FFFFECB3" 
                                BorderThickness="1" CornerRadius="4" Margin="0,15,0,5">
                            <TextBlock Text="📏 Рулон обоев" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Ширина рулона:" Margin="5,10" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="12" Grid.Column="1" Name="cmbRollWidth" 
                                  SelectedIndex="0" Margin="5,5" Height="30" FontSize="12">
                            <ComboBoxItem Content="1,0 м (стандартный)"/>
                            <ComboBoxItem Content="0,5 м (узкий)"/>
                        </ComboBox>
                        <TextBlock Grid.Row="12" Grid.Column="2" Text="длина: 10,5 м" Foreground="Gray" Margin="5,10"/>

                        <Button Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" 
                                Content="РАССЧИТАТЬ ОБОИ" 
                                Click="CalculateWallpaper_Click" Height="45" Margin="0,30" 
                                Background="#FF2196F3" Foreground="White" FontWeight="Bold"
                                FontSize="14" BorderThickness="0" Cursor="Hand"
                                BorderBrush="#FF1976D2">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Border Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" 
                                BorderBrush="#FF4CAF50" BorderThickness="2" 
                                Background="#FFF1F8E9" Margin="0,20" Padding="20"
                                CornerRadius="8" Visibility="Collapsed"
                                x:Name="wallpaperResultBorder">
                            <StackPanel>
                                <TextBlock Text="РЕЗУЛЬТАТ РАСЧЁТА ОБОЕВ" 
                                           FontSize="16" FontWeight="Bold" 
                                           Foreground="#FF2E7D32" 
                                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Name="txtWallpaperResult" TextWrapping="Wrap" FontSize="13"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Линолеум">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                                   Text="Расчёт линолеума для пола" 
                                   FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" 
                                BorderThickness="1" CornerRadius="4" Margin="0,5">
                            <TextBlock Text="Размеры комнаты" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ширина комнаты (м):" Margin="5,15"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtLinRoomWidth" Text="3,5" Margin="5,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="например: 3,5"  Margin="5,15"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Длина комнаты (м):" Margin="5,15"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="txtLinRoomLength" Text="4,0" Margin="5,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="например: 4,0"  Margin="5,15"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="3" 
                                BorderThickness="1" CornerRadius="4" Margin="0,20,0,5">
                            <TextBlock Text="Линолеум" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ширина рулона:" Margin="5,15" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Name="cmbLinoleumWidth" 
                                  SelectedIndex="0" Margin="5,10" Height="30" FontSize="12">
                            <ComboBoxItem Content="2,0 м"/>
                            <ComboBoxItem Content="2,5 м"/>
                            <ComboBoxItem Content="3,0 м"/>
                            <ComboBoxItem Content="3,5 м"/>
                        </ComboBox>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="выберите ширину" Margin="5,15"/>

                        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" 
                                Content="РАССЧИТАТЬ ЛИНОЛЕУМ" 
                                Click="CalculateLinoleum_Click" Height="45" Margin="0,30"    FontSize="14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="2" Margin="0,20" Padding="20" CornerRadius="8" Visibility="Collapsed" x:Name="linoleumResultBorder">
                            <StackPanel>
                                <TextBlock Text="РЕЗУЛЬТАТ РАСЧЁТА ЛИНОЛЕУМА" 
                                           FontSize="16"  HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Name="txtLinoleumResult" TextWrapping="Wrap" FontSize="13"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

           
            <TabItem Header="Краска">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                                   Text="Расчёт краски для потолка" 
                                   FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderThickness="1" CornerRadius="4" Margin="0,5">
                            <TextBlock Text="Размеры комнаты" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ширина комнаты (м):" Margin="5,15"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="txtPaintRoomWidth" Text="4,0" Margin="5,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="например: 4,0" Margin="5,15"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Длина комнаты (м):" Margin="5,15"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="txtPaintRoomLength" Text="5,0" Margin="5,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="например: 5,0" Margin="5,15"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="3"
                                BorderThickness="1" CornerRadius="4" Margin="0,20,0,5">
                            <TextBlock Text="Параметры краски" 
                                       FontWeight="Bold" FontSize="14"
                                       Margin="15,10"/>
                        </Border>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Расход краски (л/м²):" Margin="5,15"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Name="txtPaintConsumption" Text="0,15" Margin="5,10"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="например: 0,15"  Margin="5,15"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Объём банки (л):" Margin="5,15"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Name="txtCanVolume" Text="2,5" Margin="5,10"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="например: 2,5"  Margin="5,15"/>

                        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" 
                                Content="РАССЧИТАТЬ КРАСКУ" 
                                Click="CalculatePaint_Click" Height="45" Margin="0,30" 
                                FontSize="14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="2" Margin="0,20" Padding="20" CornerRadius="8" Visibility="Collapsed" x:Name="paintResultBorder">
                            <StackPanel>
                                <TextBlock Text="РЕЗУЛЬТАТ РАСЧЁТА КРАСКИ" 
                                           FontSize="16"  
                                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Name="txtPaintResult" TextWrapping="Wrap" FontSize="13"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
